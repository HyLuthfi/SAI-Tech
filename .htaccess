# Prevent directory listing
Options -Indexes

# Block direct access to _archive folder (return 404 Not Found)
RedirectMatch 404 ^/_archive(/.*)?$

# Block access to hidden dot files and directories (e.g. .htaccess, .git, .env)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
RedirectMatch 404 ^/\.

# Enterprise HTTP Security Headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Defense-in-depth: Deny direct access to _archive folder
  RewriteRule ^_archive(/.*)?$ - [F,L,NC]

  # Redirect /index.html or /index to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Redirect /page.html to /page
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^/]+)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Internally rewrite /page to /page.html if page.html exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
