# ================================================================
# SAI TECH - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ================================================================

# 1. Google OAuth 2.0 Client ID
# Contoh: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# 2. Whitelist Email Admin
# Contoh: owner@saitech.id,admin@saitech.id,email-anda@gmail.com
ADMIN_ALLOWED_EMAILS=owner@saitech.id,admin@saitech.id

# 3. Port Server
PORT=3000

# 4. Mode Pengembang (true / false)
DEV_MODE_ALLOWED=true
